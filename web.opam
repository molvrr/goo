# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "HTTP/1.1 and WebSocket server and client on Goo"
license: "ISC"
depends: [
  "dune" {>= "3.26"}
  "ocaml"
  "goo"
  "html"
  "uri"
  "logs"
  "base64"
  "digestif"
  "angstrom"
  "faraday"
  "bigstringaf"
  "httpun-types"
  "tls"
  "x509"
  "ca-certs-nss"
  "mirage-crypto-rng"
  "domain-name"
  "ipaddr"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
