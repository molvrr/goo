opam-version: "2.0"
synopsis: "Caqti on Goo (Postgres)"
license: "ISC"
depends: [
  "dune" {>= "3.26"}
  "ocaml"
  "goo"
  "caqti"
  "caqti-driver-postgresql"
  "mtime"
  "ipaddr"
  "domain-name"
  "uri"
  "logs"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
