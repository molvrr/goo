opam-version: "2.0"
synopsis:
  "Live pages: re-rendered with Datastar when the Postgres tables they read change"
license: "ISC"
depends: [
  "dune" {>= "3.26"}
  "ocaml"
  "goo"
  "web"
  "html"
  "datastar"
  "caqti"
  "caqti-goo"
  "postgresql"
  "yojson"
  "logs"
  "uri"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
